# Bridge server URL for production (when web and bridge are on different hosts)
# Leave empty to use same-origin proxy paths (/stud, /auth, /codex)
# VITE_BRIDGE_URL=https://api.your-stud-deployment.com

# Phase 1 server-owned agent providers. Set these on the bridge/server process,
# not as VITE_ variables and not in browser storage.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
# STUD_CODEX_ACCESS_TOKEN=...
# STUD_CODEX_ACCOUNT_ID=...

# Optional local API guard for /agent endpoints. A VITE_ copy is only suitable
# for local development because browser-visible values are not production auth.
# STUD_AGENT_API_KEY=local-dev-key
# VITE_STUD_AGENT_API_KEY=local-dev-key

# Port for the bridge server (server only)
# PORT=3001
