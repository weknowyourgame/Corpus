# ── REQUIRED ────────────────────────────────────────────
# OpenRouter API key — all model traffic goes through this
OPENROUTER_API_KEY=sk-or-...

# ── OPTIONAL: Cloudflare AI Gateway ─────────────────────
# Adds analytics, caching, rate limiting on top of OpenRouter.
# Get from: dash.cloudflare.com → AI → AI Gateway
# Requests go to: {AI_GATEWAY_URL}/openrouter/v1/chat/completions
#
# AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_name}
#
# Only needed if "Require authentication" is enabled on your CF gateway:
# CLOUDFLARE_API_TOKEN=cfat_...

# ── OPTIONAL: Roblox Open Cloud ─────────────────────────
# ROBLOX_OPEN_CLOUD_API_KEY=
# ROBLOX_UNIVERSE_ID=

# ── OPTIONAL: Roblox open-source corpus RAG ─────────────
# Disabled by default. Upload game files to R2, register rows in Postgres
# (ingested=false), then enable — the hourly cron indexes by niche automatically.
# Vectorize indexes are created on demand as roblox-{niche} (e.g. roblox-tower-defense).
# CORPUS_ENABLED=false
# CORPUS_MAX_CHUNKS=8
# CORPUS_CONTEXT_MAX_CHARS=12000
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_R2_BUCKET=roblox-games
# CLOUDFLARE_NICHE_INDEX_PREFIX=roblox
# CLOUDFLARE_WORKERS_AI_EMBED_MODEL=@cf/baai/bge-base-en-v1.5
# DATABASE_URL=

# ── OPTIONAL: Auth / local dev bypass ───────────────────
# Requires DATABASE_URL unless CORPUS_ALLOW_ANONYMOUS=true on localhost.
# CORPUS_ALLOW_ANONYMOUS=true
# CORPUS_LOGIN_TOKEN_ECHO=true
# CORPUS_COOKIE_SECURE=false
# Optional real email-token delivery. Without these, email login only works
# when CORPUS_LOGIN_TOKEN_ECHO=true for local/dev.
# RESEND_API_KEY=
# CORPUS_AUTH_EMAIL_FROM=Corpus <login@example.com>
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Must exactly match one Authorized redirect URI in Google Cloud Console.
# GOOGLE_REDIRECT_URI=http://localhost:5173/

# ── OPTIONAL: Developer / private-instance model override ────────────
# Off by default. NEVER enable in public deployments — exposes all OpenRouter
# models to authenticated users and bypasses tier routing.
#
# Local dev only:
#   1. Set CORPUS_DEV_MODE_ENABLED=true in your .env
#   2. (Optional) Set CORPUS_DEV_MODE_TOKEN=some-secret on the server.
#      Then manually run in browser devtools:
#        localStorage.setItem("corpus_dev_mode_token", "some-secret")
#      to unlock the dev-model picker. Clear it to go back to normal.
#
# CORPUS_DEV_MODE_ENABLED=false          # default — keep false in production
# CORPUS_DEV_MODE_TOKEN=                 # optional server-side secret; local/private only

# ── OPTIONAL: Production ────────────────────────────────
# NODE_ENV=production
# CORPUS_ALLOW_ANONYMOUS=false
# CORPUS_COOKIE_SECURE=true
# CORPUS_DEV_MODE_ENABLED=false
# Must exactly match one Authorized redirect URI in Google Cloud Console.
# GOOGLE_REDIRECT_URI=https://app.your-corpus-deployment.com/
# VITE_BRIDGE_URL=https://api.your-corpus-deployment.com
# PORT=3001

# ── OPTIONAL: External MCP servers ──────────────────────
# Comma-separated name:url pairs. Tools load on bridge startup and show in
# the MCP badge/status panel. Configure auth in the upstream MCP endpoint URL
# or gateway for now.
# CORPUS_MCP_SERVERS=docs:https://mcp.example.com/mcp

# ── OPTIONAL: Invite-only Discord bot ───────────────────
# Add Discord as a second chat surface without changing the web app. Requires
# DATABASE_URL in production so channel -> Studio session links survive restarts.
# Enable the bot's Server Members intent only if your role checks need it; enable
# Message Content intent for natural messages in linked project channels.
#
# CORPUS_DISCORD_ENABLED=false
# DISCORD_BOT_TOKEN=
# DISCORD_CLIENT_ID=
# CORPUS_DISCORD_GUILD_IDS=123456789012345678
# CORPUS_DISCORD_ALLOWED_ROLE_IDS=234567890123456789
# CORPUS_DISCORD_ADMIN_ROLE_IDS=345678901234567890
# CORPUS_DISCORD_DEFAULT_TIER=pro
# CORPUS_DISCORD_REGISTER_COMMANDS=true
# CORPUS_DISCORD_REQUIRE_MENTION=false
# CORPUS_DISCORD_MAX_PROMPT_LENGTH=6000
# CORPUS_DISCORD_FULL_ACCESS=false
