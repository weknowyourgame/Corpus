# ── REQUIRED ────────────────────────────────────────────
# OpenRouter API key — all model traffic goes through this
OPENROUTER_API_KEY=sk-or-...

# ── OPTIONAL: Cloudflare AI Gateway ─────────────────────
# Adds analytics, caching, rate limiting on top of OpenRouter.
# Get from: dash.cloudflare.com → AI → AI Gateway
# Requests go to: {AI_GATEWAY_URL}/openrouter/v1/chat/completions
#
# AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_name}
#
# Only needed if "Require authentication" is enabled on your CF gateway:
# CLOUDFLARE_API_TOKEN=cfat_...

# ── OPTIONAL: Roblox Open Cloud ─────────────────────────
# ROBLOX_OPEN_CLOUD_API_KEY=
# ROBLOX_UNIVERSE_ID=

# ── OPTIONAL: Local dev auth guard ──────────────────────
# STUD_AGENT_API_KEY=local-dev-key
# VITE_STUD_AGENT_API_KEY=local-dev-key

# ── OPTIONAL: Production ────────────────────────────────
# VITE_BRIDGE_URL=https://api.your-stud-deployment.com
# PORT=3001
