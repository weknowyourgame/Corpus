# ── REQUIRED ────────────────────────────────────────────
# OpenRouter API key — all model traffic goes through this
OPENROUTER_API_KEY=sk-or-...

# ── OPTIONAL: Cloudflare AI Gateway ─────────────────────
# Adds analytics, caching, rate limiting on top of OpenRouter.
# Get from: dash.cloudflare.com → AI → AI Gateway
# Requests go to: {AI_GATEWAY_URL}/openrouter/v1/chat/completions
#
# AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_name}
#
# Only needed if "Require authentication" is enabled on your CF gateway:
# CLOUDFLARE_API_TOKEN=cfat_...

# ── OPTIONAL: Roblox Open Cloud ─────────────────────────
# ROBLOX_OPEN_CLOUD_API_KEY=
# ROBLOX_UNIVERSE_ID=

# ── OPTIONAL: Roblox open-source corpus RAG ─────────────
# Disabled by default. When enabled, Stud can retrieve curated examples from
# your Roblox game knowledge base, but live Studio context remains authoritative.
# CORPUS_ENABLED=false
# CORPUS_ALLOW_UNKNOWN_LICENSE=false
# CORPUS_MAX_CHUNKS=8
# CORPUS_CONTEXT_MAX_CHARS=12000
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_R2_BUCKET=roblox-games
# CLOUDFLARE_VECTORIZE_GAME_INDEX=roblox-game-summaries
# CLOUDFLARE_VECTORIZE_SYSTEM_INDEX=roblox-systems
# CLOUDFLARE_VECTORIZE_SCRIPT_INDEX=roblox-scripts
# CLOUDFLARE_VECTORIZE_PATTERN_INDEX=roblox-patterns
# CLOUDFLARE_WORKERS_AI_EMBED_MODEL=@cf/baai/bge-base-en-v1.5
# DATABASE_URL=

# ── OPTIONAL: Local dev auth guard ──────────────────────
# STUD_AGENT_API_KEY=local-dev-key
# VITE_STUD_AGENT_API_KEY=local-dev-key

# ── OPTIONAL: Production ────────────────────────────────
# VITE_BRIDGE_URL=https://api.your-stud-deployment.com
# PORT=3001
